# Minimum first-run setup:
# 1. Set OPENAI_API_KEY (or OPENAI_DEFAULT_API_KEY)
# 2. Set NAPCAT_TOKEN
# WeChat is optional and only needed when WECHAT_BRIDGE_URL is configured.
# This product is a local AI runtime plus desktop console. Some env keys still use legacy BOT_* names for compatibility.
# The desktop console talks to the local control API on 127.0.0.1.
# In-place upgrades keep this file. setup:uninstall:keep-state keeps it too.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_BASE_URL=
OPENAI_DEFAULT_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-5.4
OPENAI_DEFAULT_BASE_URL=
OPENAI_DEFAULT_API_STYLE=responses
OPENAI_DEFAULT_REASONING_EFFORT=high
OPENAI_DEFAULT_TEXT_VERBOSITY=high
OPENAI_ADVANCED_API_KEY=
OPENAI_ADVANCED_MODEL=gpt-5.4
OPENAI_ADVANCED_BASE_URL=
OPENAI_ADVANCED_API_STYLE=responses
OPENAI_ADVANCED_REASONING_EFFORT=high
OPENAI_ADVANCED_TEXT_VERBOSITY=high
OPENAI_DEFAULT_ENABLE_WEB_SEARCH=false
OPENAI_DEFAULT_ENABLE_CODE_INTERPRETER=false
OPENAI_ADVANCED_ENABLE_WEB_SEARCH=true
OPENAI_ADVANCED_ENABLE_CODE_INTERPRETER=true
# Optional manual upgrade prefixes for the advanced route.
OPENAI_ADVANCED_TRIGGER_PREFIXES=/5.4,/gpt,/think,/analyze,/分析,/高级,/多模态,/看图,/图片分析
NAPCAT_WS_URL=ws://127.0.0.1:3001
NAPCAT_TOKEN=
WECHAT_BRIDGE_URL=
WECHAT_BRIDGE_TOKEN=
# Legacy BOT_* names remain for compatibility. They configure assistant behavior inside the local runtime.
WECHAT_BOT_PREFIX=/ai
BOT_PREFIX=/ai
BOT_SYSTEM_PROMPT=
BOT_PERSONA=
MAX_OUTPUT_CHARS=1600
ALLOWED_CHAT_IDS=
ALLOWED_USER_IDS=
# Desktop-only local attachment token. Keep it aligned with the desktop "本机连接设置" section.
QQ_AI_BOT_CONTROL_API_TOKEN=
