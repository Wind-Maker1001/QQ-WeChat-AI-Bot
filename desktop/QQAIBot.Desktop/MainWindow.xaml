                                         Text="退出控制台" />
                              <TextBlock x:Name="ExitDesktopBehaviorTextBlock"
                                         Margin="0,8,0,0"
                                         Style="{StaticResource SectionSubtitleStyle}"
                                         Text="{Binding ExitDesktopBehaviorText}" />
                            </StackPanel>
                          </Border>

                          <Border Grid.Row="2"
                                  Grid.Column="0"
                                  Style="{StaticResource InsetPanelStyle}">
                            <StackPanel>
                              <TextBlock Style="{StaticResource CardTitleStyle}"
                                         Text="停止后端" />
                              <TextBlock x:Name="StopBackendBehaviorTextBlock"
                                         Margin="0,8,0,0"
                                         Style="{StaticResource SectionSubtitleStyle}"
                                         Text="{Binding StopBackendBehaviorText}" />
                            </StackPanel>
                          </Border>

                          <Border Grid.Row="2"
                                  Grid.Column="2"
                                  Style="{StaticResource InsetPanelStyle}">
                            <StackPanel>
                              <TextBlock Style="{StaticResource CardTitleStyle}"
                                         Text="重新打开控制台" />
                              <TextBlock x:Name="ReopenDesktopBehaviorTextBlock"
                                         Margin="0,8,0,0"
                                         Style="{StaticResource SectionSubtitleStyle}"
                                         Text="{Binding ReopenDesktopBehaviorText}" />
                            </StackPanel>
                          </Border>
                        </Grid>
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
              <TabItem x:Name="DiagnosticsTabItem"
                       Header="日志与诊断">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                  <StackPanel>
                    <Border Margin="0,0,0,16"
                            Style="{StaticResource InsetPanelStyle}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="0.95*" />
                          <ColumnDefinition Width="16" />
                          <ColumnDefinition Width="1.05*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                          <TextBlock Style="{StaticResource CardTitleStyle}"
                                     Text="状态快照" />
                          <TextBlock Margin="0,4,0,0"
                                     Style="{StaticResource SectionSubtitleStyle}"
                                     Text="把快照管理集中在诊断页，避免高频配置流程被低频操作打断。" />

                          <TextBlock Margin="0,16,0,8"
                                     Style="{StaticResource FieldLabelStyle}"
                                     Text="可用快照" />
                          <ListBox x:Name="StateSnapshotsListBox"
                                   Height="220"
                                   ItemsSource="{Binding StateSnapshots}"
                                   SelectedItem="{Binding SelectedStateSnapshot, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                              <DataTemplate DataType="{x:Type models:LocalStateSnapshotDescriptor}">
                                <Border Padding="10"
                                        CornerRadius="10"
                                        BorderThickness="1">
                                  <Border.Style>
                                    <Style TargetType="Border">
                                      <Setter Property="Background" Value="{StaticResource PanelFillBrush}" />
                                      <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" />
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                          <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </Border.Style>
                                  <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding FileName}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource SectionSubtitleStyle}"
                                               Text="{Binding Summary}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Text="{Binding SizeText}" />
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>

                          <WrapPanel Margin="0,14,0,0">
                            <Button Margin="0,0,8,8"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ExportStateSnapshotCommand}"
                                    Content="导出快照" />
                            <Button Margin="0,0,8,8"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ExportSafeStateSnapshotCommand}"
                                    Content="导出安全快照" />
                            <Button Margin="0,0,8,8"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding RestoreLatestStateSnapshotCommand}"
                                    Content="恢复最近快照" />
                            <Button Margin="0,0,8,8"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding RefreshStateSnapshotsCommand}"
                                    Content="刷新列表" />
                            <Button Margin="0,0,0,8"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding OpenStateSnapshotFolderCommand}"
                                    Content="打开目录" />
                          </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                          <TextBlock Style="{StaticResource CardTitleStyle}"
                                     Text="快照详情" />
                          <TextBlock Margin="0,4,0,0"
                                     Style="{StaticResource SectionSubtitleStyle}"
                                     Text="{Binding SelectedStateSnapshotSummaryText}" />

                          <Border Margin="0,16,0,0"
                                  Style="{StaticResource InsetPanelStyle}">
                            <StackPanel>
                              <TextBlock Text="{Binding SelectedStateSnapshotDetailText}"
                                         TextWrapping="Wrap" />
                              <TextBlock Margin="0,8,0,0"
                                         Style="{StaticResource SectionSubtitleStyle}"
                                         Text="{Binding SelectedStateSnapshotImpactText}" />
                              <TextBlock Margin="0,8,0,0"
                                         Style="{StaticResource CaptionTextStyle}"
                                         Text="{Binding SelectedStateSnapshotDiffText}" />
                              <TextBlock Margin="0,8,0,0"
                                         Text="{Binding SelectedStateSnapshotAdviceText}"
                                         TextWrapping="Wrap" />
                            </StackPanel>
                          </Border>

                          <Border Margin="0,12,0,0"
                                  Padding="12,10"
                                  CornerRadius="10"
                                  Background="{StaticResource WarningFillBrush}"
                                  BorderBrush="{StaticResource WarningBorderBrush}"
                                  BorderThickness="1">
                            <StackPanel>
                              <TextBlock Style="{StaticResource CardTitleStyle}"
                                         Text="恢复前检查" />
                              <TextBlock Margin="0,8,0,0"
                                         Text="{Binding SelectedStateSnapshotSafetyHeadlineText}"
                                         TextWrapping="Wrap" />
                              <TextBlock Margin="0,6,0,0"
                                         Style="{StaticResource SectionSubtitleStyle}"
                                         Text="{Binding SelectedStateSnapshotSafetyRecommendationText}" />
                              <TextBlock Margin="0,6,0,0"
                                         Style="{StaticResource CaptionTextStyle}"
                                         Text="{Binding SelectedStateSnapshotRollbackHintText}" />
                              <WrapPanel Margin="0,12,0,0">
                                <Button Margin="0,0,8,8"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ExportSafeRollbackSnapshotCommand}"
                                        Content="导出回滚快照" />
                                <Button Margin="0,0,8,8"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding RestoreSelectedStateSnapshotCommand}"
                                        Content="恢复当前快照" />
                                <Button Margin="0,0,0,8"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Command="{Binding DeleteSelectedStateSnapshotCommand}"
                                        Content="删除当前快照" />
                              </WrapPanel>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </Grid>
                    </Border>

                    <Border Margin="0,0,0,16"
                            Style="{StaticResource InsetPanelStyle}">
                      <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}"
                                   Text="恢复摘要" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource SectionSubtitleStyle}"
                                   Text="{Binding LastStateRestoreSummaryText}" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding LastStateRestoreIssueText}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="{Binding LastStateRestoreTargetsText}" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="{Binding LastStateRestoreSessionsText}" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="{Binding LastStateRestoreLatestActivityText}" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding LastStateRestoreAdviceText}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="{Binding LastStateRestoreControlPlaneText}" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="{Binding LastStateRestoreRuntimeText}" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="{Binding LastStateRestoreNextStepText}"
                                   TextWrapping="Wrap" />

                        <WrapPanel Margin="0,12,0,0">
                          <Button Margin="0,0,8,8"
                                  Command="{Binding RunHealthActionCommand}"
                                  CommandParameter="{Binding LastStateRestorePrimaryActionKey}"
                                  Content="{Binding LastStateRestorePrimaryActionLabel}">
                            <Button.Style>
                              <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding LastStateRestorePrimaryActionLabel}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                          </Button>
                          <Button Margin="0,0,8,8"
                                  Command="{Binding RunHealthActionCommand}"
                                  CommandParameter="{Binding LastStateRestoreSecondaryActionKey}"
                                  Content="{Binding LastStateRestoreSecondaryActionLabel}">
