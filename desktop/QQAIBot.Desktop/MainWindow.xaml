<Window x:Class="QQAIBot.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:QQAIBot.Desktop.Models"
        Title="本地 AI Runtime 控制台"
        Width="1560"
        Height="980"
        MinWidth="1320"
        MinHeight="860"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        RenderOptions.ClearTypeHint="Enabled">
  <Window.Resources>
    <DataTemplate x:Key="GuideStepTemplate" DataType="{x:Type models:DesktopGuideStepItem}">
      <Border Margin="0,0,0,8"
              Padding="12,10"
              CornerRadius="10"
              BorderThickness="1">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="{StaticResource InputFillBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsComplete}" Value="True">
                <Setter Property="Background" Value="{StaticResource SuccessFillBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="28"
                    Height="28"
                    CornerRadius="14"
                    BorderThickness="1">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{StaticResource PanelFillBrush}" />
                  <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsComplete}" Value="True">
                      <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                      <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontWeight="SemiBold">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                        <Setter Property="Foreground" Value="White" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsComplete}" Value="True">
                        <Setter Property="Foreground" Value="White" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
                <Run Text="{Binding StepNumber}" />
              </TextBlock>
            </Border>
            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Text="{Binding Title}" />
            <TextBlock Grid.Column="4"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextStyle}"
                       Text="{Binding StatusText}" />
          </Grid>
          <TextBlock Margin="0,6,0,0"
                     Style="{StaticResource SectionSubtitleStyle}"
                     Text="{Binding Detail}" />
          <Button Margin="0,10,0,0"
                  HorizontalAlignment="Left"
                  Command="{Binding DataContext.RunHealthActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                  CommandParameter="{Binding ActionKey}"
                  Content="{Binding ActionLabel}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Foreground" Value="White" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding ActionLabel}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="NextActionTemplate" DataType="{x:Type models:DesktopNextActionItem}">
      <Border Margin="0,0,0,8"
              Padding="12,10"
              CornerRadius="10"
              BorderThickness="1">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="{StaticResource InputFillBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="28"
                  Height="28"
                  CornerRadius="14"
                  BorderThickness="1">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PanelFillBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                      <Setter Property="Foreground" Value="White" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
              <Run Text="{Binding StepNumber}" />
            </TextBlock>
          </Border>
          <StackPanel Grid.Column="2">
            <TextBlock FontWeight="SemiBold"
                       Text="{Binding Title}" />
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource SectionSubtitleStyle}"
                       Text="{Binding Detail}" />
            <TextBlock Margin="0,6,0,0"
                       Style="{StaticResource CaptionTextStyle}"
                       Text="{Binding Outcome}" />
            <Button Margin="0,10,0,0"
                    HorizontalAlignment="Left"
                    Command="{Binding DataContext.RunHealthActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding ActionKey}"
                    Content="{Binding ActionLabel}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                      <Setter Property="Foreground" Value="White" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ActionLabel}" Value="">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="HealthCheckTemplate" DataType="{x:Type models:DesktopHealthCheckItem}">
      <Border Margin="0,0,0,8"
              Padding="12,10"
              CornerRadius="10"
              BorderThickness="1">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="{StaticResource InputFillBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding State}" Value="{x:Static models:DesktopHealthState.Good}">
                <Setter Property="Background" Value="{StaticResource SuccessFillBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding State}" Value="{x:Static models:DesktopHealthState.Warning}">
                <Setter Property="Background" Value="{StaticResource WarningFillBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding State}" Value="{x:Static models:DesktopHealthState.Error}">
                <Setter Property="Background" Value="{StaticResource DangerFillBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock FontWeight="SemiBold"
                       Text="{Binding Title}" />
            <TextBlock Grid.Column="1"
                       Style="{StaticResource CaptionTextStyle}"
                       Text="{Binding StateText}" />
          </Grid>
          <TextBlock Margin="0,6,0,0"
                     Text="{Binding Detail}"
                     TextWrapping="Wrap" />
          <Button Margin="0,10,0,0"
                  HorizontalAlignment="Left"
                  Command="{Binding DataContext.RunHealthActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                  CommandParameter="{Binding ActionKey}"
                  Content="{Binding ActionLabel}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ActionLabel}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="RecentActivityTemplate" DataType="{x:Type models:BackendRecentActivityItem}">
      <Border Padding="0"
              CornerRadius="10"
              BorderThickness="1">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelFillBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsFailure}" Value="True">
                <Setter Property="Background" Value="{StaticResource DangerFillBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0"
                  CornerRadius="10,0,0,10">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsFailure}" Value="True">
                    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
          </Border>
          <StackPanel Grid.Column="1"
                      Margin="12,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock FontWeight="SemiBold"
                         Text="{Binding EventType}" />
              <Border Grid.Column="1"
                      Padding="8,3"
                      CornerRadius="999"
                      BorderThickness="1">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource SuccessFillBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsFailure}" Value="True">
                        <Setter Property="Background" Value="{StaticResource DangerFillBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock>
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                      <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFailure}" Value="True">
                          <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                  <Run Text="{Binding CapturedAt}" />
                </TextBlock>
              </Border>
            </Grid>
            <TextBlock Margin="0,4,0,0"
                       Text="{Binding Summary}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource CaptionTextStyle}"
                       Text="{Binding Meta}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid Background="{StaticResource HeroGradientBrush}">
    <Border Background="{StaticResource MicaOverlayBrush}" />

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
    <Grid Margin="24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="320" />
      </Grid.RowDefinitions>

      <Border x:Name="HeroHeaderCard"
              Grid.Row="0"
              Margin="0,0,0,16"
              Padding="16,13,16,12"
              Style="{StaticResource HeroCardStyle}">
        <Grid VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="32" />
            <ColumnDefinition Width="360" />
          </Grid.ColumnDefinitions>

          <StackPanel>
            <TextBlock Style="{StaticResource PageTitleStyle}"
                       Text="本地 AI Runtime" />
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource PageSubtitleStyle}"
                       Text="管理 QQ / 微信渠道、本地 API、模型路由与运行状态" />
            <WrapPanel Margin="0,10,0,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource HeaderMetaLabelStyle}"
                           Text="配置" />
                <TextBlock Margin="6,0,0,0"
                           Style="{StaticResource HeaderMetaValueStyle}"
                           Text="{Binding ConfigStateText}" />
              </StackPanel>
              <TextBlock Margin="12,0,12,0"
                         Style="{StaticResource CaptionTextStyle}"
                         Text="•" />
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource HeaderMetaLabelStyle}"
                           Text="健康" />
                <TextBlock Margin="6,0,0,0"
                           Style="{StaticResource HeaderMetaValueStyle}"
                           Text="{Binding HealthStateText}" />
              </StackPanel>
            </WrapPanel>
          </StackPanel>

          <StackPanel Grid.Column="2"
                      VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
              <Border Padding="12,6"
                      CornerRadius="999"
                      BorderThickness="1">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource PanelFillBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsProcessRunning}" Value="True">
                        <Setter Property="Background" Value="{StaticResource SuccessFillBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock Text="{Binding ProcessStateText}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource StatusBadgeTextStyle}">
                      <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsProcessRunning}" Value="True">
                          <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Border>
            </StackPanel>

            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBlock x:Name="OverallReadinessRecentActivityTextBlock"
                         VerticalAlignment="Center"
                         Style="{StaticResource SectionSubtitleStyle}"
                         Text="{Binding OverallReadinessRecentActivityText}" />

              <StackPanel Grid.Column="2"
                          Orientation="Horizontal"
                          VerticalAlignment="Center">
                <Button Margin="0,0,8,0"
                        Style="{StaticResource TextActionButtonStyle}"
                        Command="{Binding RunHealthActionCommand}"
                        CommandParameter="focus_latest_activity"
                        Content="最近活动" />
                <Button Style="{StaticResource CommandSecondaryButtonStyle}"
                        Command="{Binding RunHealthActionCommand}"
                        CommandParameter="show_logs"
                        Content="查看日志" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>

      <Grid x:Name="OverviewCardsPanel"
            Grid.Row="1"
            Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.12*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="0.96*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="0.96*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="0.96*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Style="{StaticResource EmphasisSummaryCardStyle}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Width="32"
                      Height="32"
                      CornerRadius="16"
                      Background="{StaticResource AccentSoftBrush}">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="14"
                           Foreground="{StaticResource AccentBrush}"
                           Text="&#xE768;" />
              </Border>
              <TextBlock Grid.Column="2"
                         VerticalAlignment="Center"
                         Style="{StaticResource CardTitleStyle}"
                         Text="Runtime 状态" />
              <Border Grid.Column="3"
                      Padding="8,3"
                      CornerRadius="999"
                      BorderThickness="1">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource PanelFillBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsProcessRunning}" Value="True">
                        <Setter Property="Background" Value="{StaticResource SuccessFillBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock Style="{StaticResource CaptionTextStyle}"
                           Text="{Binding ProcessStateText}" />
              </Border>
            </Grid>

            <TextBlock Margin="0,16,0,0"
                       Style="{StaticResource SummaryHeroValueStyle}"
                       Text="{Binding ProcessStateText}" />
            <TextBlock Margin="0,6,0,0"
                       Style="{StaticResource SummaryLeadTextStyle}"
                       Text="{Binding StatusText}" />

            <Border Margin="0,12,0,10"
                    Height="1"
                    Background="{StaticResource DividerBrush}" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource SummaryRowLabelStyle}"
                           Text="最近加载" />
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource SummaryRowValueStyle}"
                           Text="{Binding LastLoadedAtText}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource SummaryRowLabelStyle}"
                           Text="最近保存" />
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource SummaryRowValueStyle}"
                           Text="{Binding LastSavedAtText}" />
              </StackPanel>
            </Grid>

            <TextBlock Margin="0,10,0,0"
                       Style="{StaticResource CaptionTextStyle}"
                       Text="{Binding ConfigStateText}" />
          </StackPanel>
        </Border>

        <Border Grid.Column="2"
                Style="{StaticResource SummaryCardStyle}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Width="32"
                      Height="32"
                      CornerRadius="16"
                      Background="{StaticResource InfoFillBrush}">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="14"
                           Foreground="{StaticResource InfoBrush}"
                           Text="&#xE8BD;" />
              </Border>
              <TextBlock Grid.Column="2"
                         VerticalAlignment="Center"
                         Style="{StaticResource CardTitleStyle}"
                         Text="渠道状态" />
              <Border Grid.Column="3"
                      Padding="8,3"
                      CornerRadius="999"
                      Background="{StaticResource PanelFillBrush}"
                      BorderBrush="{StaticResource InputBorderBrush}"
                      BorderThickness="1">
                <TextBlock Style="{StaticResource CaptionTextStyle}"
                           Text="QQ / 微信" />
              </Border>
            </Grid>

            <TextBlock Margin="0,12,0,0"
                       Style="{StaticResource SummaryRowLabelStyle}"
                       Text="QQ" />
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource SummaryPrimaryValueStyle}"
                       FontSize="18"
                       Text="{Binding RuntimeReadyText}" />
            <TextBlock Margin="0,8,0,0"
                       Style="{StaticResource SummaryRowLabelStyle}"
                       Text="微信" />
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource SummaryLeadTextStyle}"
                       Text="{Binding WechatRuntimeReadyText}" />

            <Border Margin="0,12,0,10"
                    Height="1"
                    Background="{StaticResource DividerBrush}" />

            <TextBlock Style="{StaticResource SummaryRowLabelStyle}"
                       Text="Bridge" />
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource SummaryRowValueStyle}"
                       Text="{Binding WechatBridgeStateText}" />
            <TextBlock Margin="0,8,0,0"
                       Style="{StaticResource CaptionTextStyle}"
                       Text="{Binding LatestQqActivitySummaryText}" />
          </StackPanel>
        </Border>

        <Border Grid.Column="4"
                Style="{StaticResource SummaryCardStyle}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Width="32"
                      Height="32"
                      CornerRadius="16"
                      Background="{StaticResource WarningFillBrush}">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="14"
                           Foreground="{StaticResource WarningBrush}"
                           Text="&#xE946;" />
              </Border>
              <TextBlock Grid.Column="2"
                         VerticalAlignment="Center"
                         Style="{StaticResource CardTitleStyle}"
                         Text="系统状态" />
              <Border Grid.Column="3"
                      Padding="8,3"
                      CornerRadius="999"
                      BorderThickness="1">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource WarningFillBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsOverallReadinessReady}" Value="True">
                        <Setter Property="Background" Value="{StaticResource SuccessFillBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock Style="{StaticResource CaptionTextStyle}"
                           Text="{Binding HealthStateText}" />
              </Border>
            </Grid>

            <TextBlock Margin="0,14,0,0"
                       Style="{StaticResource SummaryPrimaryValueStyle}"
                       FontSize="18"
                       Text="{Binding AutoStartStateText}" />

            <Border Margin="0,12,0,10"
                    Height="1"
                    Background="{StaticResource DividerBrush}" />

            <TextBlock Style="{StaticResource SummaryRowLabelStyle}"
                       Text="目录检测" />
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource SummaryRowValueStyle}"
                       Text="{Binding BackendRootStateText}" />
            <TextBlock Margin="0,8,0,0"
                       Style="{StaticResource SummaryRowLabelStyle}"
                       Text="本机连接" />
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource SummaryRowValueStyle}"
                       Text="{Binding ControlApiTokenStateText}" />
            <TextBlock Margin="0,8,0,0"
                       Style="{StaticResource CaptionTextStyle}"
                       Text="{Binding HealthSummaryText}" />
          </StackPanel>
        </Border>

        <Border Grid.Column="6"
                Style="{StaticResource SummaryCardStyle}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Width="32"
                      Height="32"
                      CornerRadius="16"
                      Background="{StaticResource AccentSoftBrush}">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="14"
                           Foreground="{StaticResource AccentBrush}"
                           Text="&#xE7BE;" />
              </Border>
              <TextBlock Grid.Column="2"
                         VerticalAlignment="Center"
                         Style="{StaticResource CardTitleStyle}"
                         Text="模型与路由" />
              <Border Grid.Column="3"
                      Padding="8,3"
                      CornerRadius="999"
                      Background="{StaticResource AccentSoftBrush}"
                      BorderBrush="{StaticResource AccentBrush}"
                      BorderThickness="1">
                <TextBlock Style="{StaticResource CaptionTextStyle}"
                           Foreground="{StaticResource AccentBrush}"
                           Text="已配置" />
              </Border>
            </Grid>

            <TextBlock Margin="0,12,0,0"
                       Style="{StaticResource SummaryRowLabelStyle}"
                       Text="默认模型" />
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource SummaryPrimaryValueStyle}"
                       FontSize="18"
                       Text="{Binding OpenAiDefaultModel}" />
            <TextBlock Margin="0,8,0,0"
                       Style="{StaticResource SummaryRowLabelStyle}"
                       Text="高级模型" />
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource SummaryLeadTextStyle}"
                       Text="{Binding OpenAiModel}" />

            <Border Margin="0,12,0,10"
                    Height="1"
                    Background="{StaticResource DividerBrush}" />

            <TextBlock Style="{StaticResource SummaryRowLabelStyle}"
                       Text="路由状态" />
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource SummaryRowValueStyle}"
                       Text="{Binding StatusText}" />
            <TextBlock Margin="0,8,0,0"
                       Style="{StaticResource CaptionTextStyle}"
                       Text="{Binding HealthChecklistStatusText}" />
          </StackPanel>
        </Border>
      </Grid>
      <Border x:Name="ToolbarShellCard"
              Grid.Row="2"
              Margin="0,0,0,16"
              Style="{StaticResource ShellCardStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock Style="{StaticResource SectionEyebrowStyle}"
                       Text="主操作" />
            <StackPanel Margin="0,8,0,0"
                        Orientation="Horizontal">
              <Button x:Name="StartButton"
                      Margin="0,0,8,0"
                      Style="{StaticResource PrimaryButtonStyle}"
                      Command="{Binding StartCommand}"
                      Content="启动后端" />
              <Button x:Name="StopButton"
                      Style="{StaticResource DangerButtonStyle}"
                      Command="{Binding StopCommand}"
                      Content="停止后端" />
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Column="2">
            <TextBlock Style="{StaticResource SectionEyebrowStyle}"
                       Text="配置与同步" />
            <StackPanel Margin="0,8,0,0"
                        Orientation="Horizontal">
              <Button x:Name="ReloadButton"
                      Margin="0,0,8,0"
                      Style="{StaticResource CommandSecondaryButtonStyle}"
                      Command="{Binding ReloadCommand}"
                      Content="重新加载" />
              <Button x:Name="SaveButton"
                      Margin="0,0,8,0"
                      Style="{StaticResource CommandSecondaryButtonStyle}"
                      Command="{Binding SaveCommand}"
                      Content="保存配置" />
              <Button x:Name="AutoDetectButton"
                      Margin="0,0,8,0"
                      Style="{StaticResource QuietButtonStyle}"
                      Command="{Binding AutoDetectCommand}"
                      Content="自动检测" />
              <Button x:Name="MoreActionsButton"
                      Style="{StaticResource QuietButtonStyle}"
                      Click="MoreActionsButton_OnClick"
                      Content="更多">
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="打开目录"
                              Command="{Binding PlacementTarget.DataContext.OpenBackendFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="{Binding PlacementTarget.DataContext.AutoStartButtonText, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              Command="{Binding PlacementTarget.DataContext.ToggleAutoStartCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <Separator />
                    <MenuItem Header="退出控制台"
                              Click="ExitDesktopButton_OnClick" />
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
            </StackPanel>
          </StackPanel>

          <Border Grid.Row="1"
                  Grid.ColumnSpan="3"
                  Margin="0,12,0,0"
                  Style="{StaticResource SubtleInfoBarStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center"
                         FontFamily="Segoe MDL2 Assets"
                         FontSize="13"
                         Foreground="{StaticResource AccentBrush}"
                         Text="&#xE946;" />
              <TextBlock Grid.Column="2"
                         VerticalAlignment="Center"
                         Style="{StaticResource SummaryRowValueStyle}"
                         Text="{Binding OverallReadinessSummaryText}" />
              <Button Grid.Column="4"
                      VerticalAlignment="Center"
                      Command="{Binding RunHealthActionCommand}"
                      CommandParameter="{Binding HealthPrimaryActionKey}"
                      Content="{Binding HealthPrimaryActionLabel}">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource TextActionButtonStyle}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HealthPrimaryActionLabel}" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Grid x:Name="SuggestionsPanel"
            Grid.Row="3"
            Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.9*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="1.1*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Style="{StaticResource PanelCardStyle}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource CardTitleStyle}"
                         Text="当前建议" />
              <Border Grid.Column="1"
                      Padding="10,4"
                      CornerRadius="999"
                      BorderThickness="1">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource WarningFillBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsOverallReadinessReady}" Value="True">
                        <Setter Property="Background" Value="{StaticResource SuccessFillBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock x:Name="OverallReadinessStateTextBlock"
                           Style="{StaticResource StatusBadgeTextStyle}"
                           Text="{Binding OverallReadinessStateText}" />
              </Border>
            </Grid>

            <TextBlock x:Name="OverallReadinessSummaryTextBlock"
                       Margin="0,12,0,0"
                       Style="{StaticResource SummaryPrimaryValueStyle}"
                       FontSize="18"
                       Text="{Binding OverallReadinessSummaryText}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="OverallReadinessActionSummaryTextBlock"
                       Margin="0,6,0,0"
                       Style="{StaticResource CaptionTextStyle}"
                       Text="{Binding HealthActionSummaryText}" />

            <Button x:Name="OverallReadinessActionButton"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Left"
                    Command="{Binding RunHealthActionCommand}"
                    CommandParameter="{Binding OverallReadinessActionKey}"
                    Content="{Binding OverallReadinessActionLabel}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding OverallReadinessActionLabel}" Value="">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>

            <Border Margin="0,12,0,10"
                    Height="1"
                    Background="{StaticResource DividerBrush}" />

            <TextBlock Style="{StaticResource CaptionTextStyle}"
                       Text="{Binding HealthReadyNowText}"
                       TextWrapping="Wrap" />

            <Expander Margin="0,10,0,0">
              <Expander.Header>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock FontWeight="SemiBold"
                             Text="后续建议" />
                  <TextBlock Grid.Column="1"
                             Style="{StaticResource CaptionTextStyle}"
                             Text="{Binding HealthStateText}" />
                </Grid>
              </Expander.Header>
              <ItemsControl x:Name="OverallReadinessActionsItemsControl"
                            ItemTemplate="{StaticResource NextActionTemplate}"
                            ItemsSource="{Binding HealthNextActions}">
                <ItemsControl.Style>
                  <Style TargetType="ItemsControl">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasHealthNextActions}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ItemsControl.Style>
              </ItemsControl>
            </Expander>
          </StackPanel>
        </Border>

        <Border Grid.Column="2"
                Style="{StaticResource PanelCardStyle}">
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitleStyle}"
                       Text="环境摘要" />

            <StackPanel Margin="0,14,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="80" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource CaptionTextStyle}"
                           Text="默认 API Key" />
                <TextBlock Grid.Column="1">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource SummaryRowValueStyle}">
                      <Setter Property="Text" Value="已配置" />
                      <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding OpenAiDefaultApiKey}" Value="">
                          <Setter Property="Text" Value="未配置" />
                          <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding OpenAiDefaultApiKey}" Value="{x:Null}">
                          <Setter Property="Text" Value="未配置" />
                          <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>

              <Border Margin="0,8,0,8"
                      Height="1"
                      Background="{StaticResource DividerBrush}" />

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="80" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource CaptionTextStyle}"
                           Text="高级路由" />
                <TextBlock Grid.Column="1">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource SummaryRowValueStyle}">
                      <Setter Property="Text" Value="已配置" />
                      <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding OpenAiApiKey}" Value="">
                          <Setter Property="Text" Value="待补充" />
                          <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding OpenAiApiKey}" Value="{x:Null}">
                          <Setter Property="Text" Value="待补充" />
                          <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>

              <Border Margin="0,8,0,8"
                      Height="1"
                      Background="{StaticResource DividerBrush}" />

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="80" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource CaptionTextStyle}"
                           Text="目录检测" />
                <TextBlock Grid.Column="1"
                           Style="{StaticResource SummaryRowValueStyle}"
                           Text="{Binding BackendRootStateText}" />
              </Grid>

              <Border Margin="0,8,0,8"
                      Height="1"
                      Background="{StaticResource DividerBrush}" />

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="80" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource CaptionTextStyle}"
                           Text="自动启动" />
                <TextBlock Grid.Column="1"
                           Style="{StaticResource SummaryRowValueStyle}"
                           Text="{Binding AutoStartStateText}" />
              </Grid>

              <Border Margin="0,8,0,8"
                      Height="1"
                      Background="{StaticResource DividerBrush}" />

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="80" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource CaptionTextStyle}"
                           Text="本机连接" />
                <TextBlock Grid.Column="1"
                           Style="{StaticResource SummaryRowValueStyle}"
                           Text="{Binding ControlApiTokenStateText}" />
              </Grid>

              <Border Margin="0,8,0,8"
                      Height="1"
                      Background="{StaticResource DividerBrush}" />

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="80" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource CaptionTextStyle}"
                           Text="渠道状态" />
                <TextBlock Grid.Column="1"
                           Style="{StaticResource SummaryRowValueStyle}"
                           Text="{Binding RuntimeReadyText}" />
              </Grid>
            </StackPanel>

            <Expander Margin="0,14,0,0">
              <Expander.Header>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock FontWeight="SemiBold"
                             Text="首次打开引导" />
                  <TextBlock x:Name="FirstRunGuideCurrentTextBlock"
                             Grid.Column="1"
                             Style="{StaticResource CaptionTextStyle}"
                             Text="{Binding FirstRunGuideCurrentStepText}" />
                </Grid>
              </Expander.Header>
              <StackPanel>
                <TextBlock x:Name="FirstRunGuideTextBlock"
                           Style="{StaticResource SectionSubtitleStyle}"
                           Text="{Binding FirstRunGuideText}" />
                <TextBlock x:Name="FirstRunGuideProgressTextBlock"
                           Visibility="Collapsed"
                           Text="{Binding FirstRunGuideProgressText}" />
                <TextBlock x:Name="FirstRunGuideCompletionTextBlock"
                           Margin="0,8,0,0"
                           Text="{Binding FirstRunGuideCompletionText}"
                           TextWrapping="Wrap" />
                <ItemsControl x:Name="FirstRunGuideStepsItemsControl"
                              Margin="0,10,0,0"
                              ItemTemplate="{StaticResource GuideStepTemplate}"
                              ItemsSource="{Binding FirstRunGuideSteps}" />
              </StackPanel>
            </Expander>

            <Expander>
              <Expander.Header>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock FontWeight="SemiBold"
                             Text="日常常驻引导" />
                  <TextBlock x:Name="DailyUseGuideCurrentTextBlock"
                             Grid.Column="1"
                             Style="{StaticResource CaptionTextStyle}"
                             Text="{Binding DailyUseGuideCurrentStepText}" />
                </Grid>
              </Expander.Header>
              <StackPanel>
                <TextBlock x:Name="DailyUseGuideTextBlock"
                           Style="{StaticResource SectionSubtitleStyle}"
                           Text="{Binding DailyUseGuideText}" />
                <TextBlock x:Name="DailyUseGuideProgressTextBlock"
                           Visibility="Collapsed"
                           Text="{Binding DailyUseGuideProgressText}" />
                <TextBlock x:Name="DailyUseGuideCompletionTextBlock"
                           Margin="0,8,0,0"
                           Text="{Binding DailyUseGuideCompletionText}"
                           TextWrapping="Wrap" />
                <ItemsControl x:Name="DailyUseGuideStepsItemsControl"
                              Margin="0,10,0,0"
                              ItemTemplate="{StaticResource GuideStepTemplate}"
                              ItemsSource="{Binding DailyUseGuideSteps}" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>
      </Grid>
      <Grid Grid.Row="4"
            Margin="0,0,0,16"
            MinHeight="480">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.58*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="1.02*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="ConfigurationWorkspace"
                Grid.Column="0"
                Style="{StaticResource PanelCardStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="12" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
              <TextBlock Style="{StaticResource SectionTitleStyle}"
                         Text="详细配置" />
            </StackPanel>

            <TabControl x:Name="SettingsTabControl"
                        Grid.Row="2">
              <TabItem x:Name="ModelApiTabItem"
                       Header="模型与 API">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                  <StackPanel>
                    <Border x:Name="OpenAiCard"
                            Margin="0,0,0,16"
                            Style="{StaticResource InsetPanelStyle}">
                      <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}"
                                   Text="API 连接" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource SectionSubtitleStyle}"
                                   Text="共享默认与高级路由的密钥和接口地址，按连接关系组织字段，而不是按环境变量名堆叠。" />

                        <Grid Margin="0,16,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>

                          <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                       Text="默认路由 API Key" />
                            <TextBox x:Name="OpenAiDefaultApiKeyTextBox"
                                     Text="{Binding OpenAiDefaultApiKey, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Text="留空时会继承高级路由密钥。" />

                            <TextBlock Margin="0,16,0,8"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Text="默认路由 Base URL" />
                            <TextBox Text="{Binding OpenAiDefaultBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                          </StackPanel>

                          <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                       Text="高级路由 API Key" />
                            <TextBox x:Name="OpenAiApiKeyTextBox"
                                     Text="{Binding OpenAiApiKey, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Text="用于图片、复杂请求或高级触发词。" />

                            <TextBlock Margin="0,16,0,8"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Text="高级路由 Base URL" />
                            <TextBox Text="{Binding OpenAiBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </Border>

                    <Border Margin="0,0,0,16"
                            Style="{StaticResource InsetPanelStyle}">
                      <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}"
                                   Text="模型路由" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource SectionSubtitleStyle}"
                                   Text="这里定义基础模型、高级模型和触发高级路由的条件。" />

                        <Grid Margin="0,16,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>

                          <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                       Text="默认模型" />
                            <TextBox Text="{Binding OpenAiDefaultModel, UpdateSourceTrigger=PropertyChanged}" />
                          </StackPanel>

                          <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                       Text="高级模型" />
                            <TextBox Text="{Binding OpenAiModel, UpdateSourceTrigger=PropertyChanged}" />
                          </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,16,0,8"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Text="高级触发前缀" />
                        <TextBox Text="{Binding OpenAiAdvancedTriggerPrefixes, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="如图片、复杂推理或你约定的高级命令前缀。" />

                        <Grid Margin="0,16,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                       Text="默认 Reasoning Effort" />
                            <TextBox Text="{Binding OpenAiDefaultReasoningEffort, UpdateSourceTrigger=PropertyChanged}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                       Text="高级 Reasoning Effort" />
                            <TextBox Text="{Binding OpenAiAdvancedReasoningEffort, UpdateSourceTrigger=PropertyChanged}" />
                          </StackPanel>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                       Text="默认 Text Verbosity" />
                            <TextBox Text="{Binding OpenAiDefaultTextVerbosity, UpdateSourceTrigger=PropertyChanged}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                       Text="高级 Text Verbosity" />
                            <TextBox Text="{Binding OpenAiAdvancedTextVerbosity, UpdateSourceTrigger=PropertyChanged}" />
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </Border>

                    <Border Style="{StaticResource InsetPanelStyle}">
                      <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}"
                                   Text="能力开关与常用预设" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource SectionSubtitleStyle}"
                                   Text="能力配置默认保持安静，只在需要时针对不同路由单独开启。" />

                        <Grid Margin="0,16,0,0">
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>

                          <Border Grid.Row="0"
                                  Grid.Column="0"
                                  Style="{StaticResource InsetPanelStyle}">
                            <StackPanel>
                              <TextBlock Style="{StaticResource FieldLabelStyle}"
                                         Text="默认路由能力" />
                              <CheckBox Content="启用网页搜索"
                                        IsChecked="{Binding IsOpenAiDefaultEnableWebSearchEnabled, UpdateSourceTrigger=PropertyChanged}" />
                              <CheckBox Margin="0,10,0,0"
                                        Content="启用代码解释器"
                                        IsChecked="{Binding IsOpenAiDefaultEnableCodeInterpreterEnabled, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                          </Border>

                          <Border Grid.Row="0"
                                  Grid.Column="2"
                                  Style="{StaticResource InsetPanelStyle}">
                            <StackPanel>
                              <TextBlock Style="{StaticResource FieldLabelStyle}"
                                         Text="高级路由能力" />
                              <CheckBox Content="启用网页搜索"
                                        IsChecked="{Binding IsOpenAiAdvancedEnableWebSearchEnabled, UpdateSourceTrigger=PropertyChanged}" />
                              <CheckBox Margin="0,10,0,0"
                                        Content="启用代码解释器"
                                        IsChecked="{Binding IsOpenAiAdvancedEnableCodeInterpreterEnabled, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                          </Border>

                          <Border Grid.Row="2"
                                  Grid.ColumnSpan="3"
                                  Style="{StaticResource InsetPanelStyle}">
                            <StackPanel>
                              <TextBlock Style="{StaticResource FieldLabelStyle}"
                                         Text="Base URL 预设" />
                              <WrapPanel Margin="0,4,0,0">
                                <Button Margin="0,0,8,8"
                                        Style="{StaticResource PillButtonStyle}"
                                        Command="{Binding ApplyBaseUrlPresetCommand}"
                                        CommandParameter="__official__"
                                        Content="官方默认" />
                                <Button Margin="0,0,8,8"
                                        Style="{StaticResource PillButtonStyle}"
                                        Command="{Binding ApplyBaseUrlPresetCommand}"
                                        CommandParameter="https://gmncode.cn"
                                        Content="gmncode.cn" />
                                <Button Margin="0,0,8,8"
                                        Style="{StaticResource PillButtonStyle}"
                                        Command="{Binding ApplyBaseUrlPresetCommand}"
                                        CommandParameter="https://gmncode.com"
                                        Content="gmncode.com" />
                                <Button Margin="0,0,8,8"
                                        Style="{StaticResource PillButtonStyle}"
                                        Command="{Binding ApplyBaseUrlPresetCommand}"
                                        CommandParameter="https://cdn.gmncode.cn"
                                        Content="cdn.gmncode.cn" />
                                <Button Margin="0,0,0,8"
                                        Style="{StaticResource PillButtonStyle}"
                                        Command="{Binding ApplyBaseUrlPresetCommand}"
                                        CommandParameter="https://cdn.gmncode.com"
                                        Content="cdn.gmncode.com" />
                              </WrapPanel>
                            </StackPanel>
                          </Border>
                        </Grid>
                      </StackPanel>
