                                     Grid.Column="2"
                                     Text="{Binding LatestQqRequestedCapabilitiesText}"
                                     TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource SectionSubtitleStyle}"
                                   Text="{Binding LatestQqLlmDetailText}"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <Border Margin="0,10,0,0"
                            Padding="10,8"
                            CornerRadius="8"
                            Background="{StaticResource InputFillBrush}"
                            BorderBrush="{StaticResource InputBorderBrush}"
                            BorderThickness="1">
                      <StackPanel>
                        <TextBlock x:Name="LatestQqFailureTimelineTextBlock"
                                   Style="{StaticResource SectionSubtitleStyle}"
                                   Text="{Binding LatestQqFailureTimelineText}" />
                        <TextBlock x:Name="LatestQqFailureSummaryTextBlock"
                                   Margin="0,6,0,0"
                                   Text="{Binding LatestQqFailureSummaryText}"
                                   TextWrapping="Wrap" />
                        <Grid Margin="0,8,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource SectionSubtitleStyle}" Text="Trigger" />
                          <TextBlock x:Name="LatestQqFailureTriggerTextBlock"
                                     Grid.Row="0"
                                     Grid.Column="2"
                                     Text="{Binding LatestQqFailureTriggerText}"
                                     TextWrapping="Wrap" />
                          <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource SectionSubtitleStyle}" Text="Capability" />
                          <TextBlock x:Name="LatestQqFailureCapabilityTextBlock"
                                     Grid.Row="2"
                                     Grid.Column="2"
                                     Text="{Binding LatestQqFailureCapabilityText}"
                                     TextWrapping="Wrap" />
                          <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource SectionSubtitleStyle}" Text="Upgrade" />
                          <TextBlock x:Name="LatestQqFailureUpgradeTextBlock"
                                     Grid.Row="4"
                                     Grid.Column="2"
                                     Text="{Binding LatestQqFailureUpgradeText}"
                                     TextWrapping="Wrap" />
                          <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource SectionSubtitleStyle}" Text="Error" />
                          <TextBlock x:Name="LatestQqFailureErrorTextBlock"
                                     Grid.Row="6"
                                     Grid.Column="2"
                                     Text="{Binding LatestQqFailureErrorText}"
                                     TextWrapping="Wrap" />
                        </Grid>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>

                <Border x:Name="WechatActivityCard"
                        Margin="0,12,0,0"
                        Padding="12"
                        CornerRadius="10"
                        Background="{StaticResource PanelFillBrush}"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="1">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Style="{StaticResource SectionSubtitleStyle}" Text="Wechat Activity" />
                      <ToggleButton x:Name="WechatFailuresOnlyToggleButton"
                                    Grid.Column="1"
                                    Style="{StaticResource FilterToggleButtonStyle}"
                                    IsChecked="{Binding ShowOnlyWechatFailures, Mode=TwoWay}"
                                    Content="Failures only" />
                      <ToggleButton x:Name="WechatPinSelectionToggleButton"
                                    Grid.Column="3"
                                    Style="{StaticResource FilterToggleButtonStyle}"
                                    IsChecked="{Binding PinSelectedWechatActivity, Mode=TwoWay}"
                                    Content="Pin selection" />
                    </Grid>
                    <Button x:Name="ClearWechatActivityHistoryButton"
                            Margin="0,8,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ClearWechatActivityHistoryCommand}"
                            Content="Clear activity history" />
                    <TextBlock x:Name="LatestWechatActivitySummaryTextBlock"
                               Margin="0,4,0,0"
                               Text="{Binding LatestWechatActivitySummaryText}"
                               TextWrapping="Wrap" />
                    <ListBox x:Name="LatestWechatRecentActivityListBox"
                             Margin="0,8,0,0"
                             MaxHeight="160"
                             Background="{StaticResource InputFillBrush}"
                             BorderBrush="{StaticResource InputBorderBrush}"
                             BorderThickness="1"
                             ItemsSource="{Binding WechatRecentActivitiesView}"
                             SelectedItem="{Binding SelectedWechatRecentActivity, Mode=TwoWay}">
                      <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                          <Setter Property="Padding" Value="0" />
                          <Setter Property="Margin" Value="4" />
                          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="ListBoxItem">
                                <Border Background="{TemplateBinding Background}">
                                  <ContentPresenter />
                                </Border>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                          <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            </Trigger>
                          </Style.Triggers>
                        </Style>
                      </ListBox.ItemContainerStyle>
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Border Padding="8"
                                  CornerRadius="6"
                                  BorderThickness="1">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource PanelFillBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter Property="BorderThickness" Value="2" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding IsFailure}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource WarningFillBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <StackPanel>
                              <TextBlock Text="{Binding EventType}" FontWeight="SemiBold" />
                              <TextBlock Margin="0,4,0,0" Text="{Binding Summary}" TextWrapping="Wrap" />
                              <TextBlock Margin="0,4,0,0"
                                         Style="{StaticResource SectionSubtitleStyle}"
                                         Text="{Binding Meta}"
                                         TextWrapping="Wrap" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Margin="0,8,0,0"
                            Padding="10,8"
                            CornerRadius="8"
                            Background="{StaticResource InputFillBrush}"
                            BorderBrush="{StaticResource InputBorderBrush}"
                            BorderThickness="1">
                      <StackPanel>
                        <TextBlock x:Name="SelectedWechatRecentActivitySummaryTextBlock"
                                   Text="{Binding SelectedWechatRecentActivitySummaryText}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="SelectedWechatRecentActivityMetaTextBlock"
                                   Margin="0,4,0,0"
                                   Style="{StaticResource SectionSubtitleStyle}"
                                   Text="{Binding SelectedWechatRecentActivityMetaText}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="SelectedWechatRecentActivityDetailTextBlock"
                                   Margin="0,8,0,0"
                                   Style="{StaticResource SectionSubtitleStyle}"
                                   Text="{Binding SelectedWechatRecentActivityDetailText}"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                    <Grid Margin="0,8,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource SectionSubtitleStyle}" Text="State" />
                      <TextBlock x:Name="LatestWechatActivityStateTextBlock"
                                 Grid.Row="0"
                                 Grid.Column="2"
                                 Text="{Binding LatestWechatActivityStateText}"
                                 TextWrapping="Wrap" />
                      <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource SectionSubtitleStyle}" Text="Latest Success" />
                      <TextBlock x:Name="LatestWechatLatestSuccessTextBlock"
                                 Grid.Row="2"
                                 Grid.Column="2"
                                 Text="{Binding LatestWechatLatestSuccessText}"
                                 TextWrapping="Wrap" />
                      <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource SectionSubtitleStyle}" Text="Latest Failure" />
                      <TextBlock x:Name="LatestWechatLatestFailureTextBlock"
                                 Grid.Row="4"
                                 Grid.Column="2"
                                 Text="{Binding LatestWechatLatestFailureText}"
                                 TextWrapping="Wrap" />
                      <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource SectionSubtitleStyle}" Text="Recovery" />
                      <TextBlock x:Name="LatestWechatRecoveryTextBlock"
                                 Grid.Row="6"
                                 Grid.Column="2"
                                 Text="{Binding LatestWechatRecoveryText}"
                                 TextWrapping="Wrap" />
                    </Grid>

                    <Border Margin="0,10,0,0"
                            Padding="10,8"
                            CornerRadius="8"
                            Background="{StaticResource InputFillBrush}"
                            BorderBrush="{StaticResource InputBorderBrush}"
                            BorderThickness="1">
                      <StackPanel>
                        <TextBlock x:Name="LatestWechatRequestTimelineTextBlock"
                                   Style="{StaticResource SectionSubtitleStyle}"
                                   Text="{Binding LatestWechatRequestTimelineText}" />
                        <TextBlock x:Name="LatestWechatLlmSummaryTextBlock"
                                   Margin="0,6,0,0"
                                   Text="{Binding LatestWechatLlmSummaryText}"
                                   TextWrapping="Wrap" />
                        <Grid Margin="0,8,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource SectionSubtitleStyle}" Text="Trigger" />
                          <TextBlock x:Name="LatestWechatDecisionTriggerTextBlock"
                                     Grid.Row="0"
                                     Grid.Column="2"
                                     Text="{Binding LatestWechatDecisionTriggerText}"
                                     TextWrapping="Wrap" />
                          <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource SectionSubtitleStyle}" Text="Capability" />
                          <TextBlock x:Name="LatestWechatDecisionCapabilityTextBlock"
                                     Grid.Row="2"
                                     Grid.Column="2"
                                     Text="{Binding LatestWechatDecisionCapabilityText}"
                                     TextWrapping="Wrap" />
                          <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource SectionSubtitleStyle}" Text="Upgrade" />
                          <TextBlock x:Name="LatestWechatDecisionUpgradeTextBlock"
                                     Grid.Row="4"
                                     Grid.Column="2"
                                     Text="{Binding LatestWechatDecisionUpgradeText}"
                                     TextWrapping="Wrap" />
                          <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource SectionSubtitleStyle}" Text="Requested" />
                          <TextBlock x:Name="LatestWechatRequestedCapabilitiesTextBlock"
                                     Grid.Row="6"
                                     Grid.Column="2"
                                     Text="{Binding LatestWechatRequestedCapabilitiesText}"
                                     TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource SectionSubtitleStyle}"
                                   Text="{Binding LatestWechatLlmDetailText}"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <Border Margin="0,10,0,0"
                            Padding="10,8"
                            CornerRadius="8"
                            Background="{StaticResource InputFillBrush}"
                            BorderBrush="{StaticResource InputBorderBrush}"
                            BorderThickness="1">
                      <StackPanel>
                        <TextBlock x:Name="LatestWechatFailureTimelineTextBlock"
                                   Style="{StaticResource SectionSubtitleStyle}"
                                   Text="{Binding LatestWechatFailureTimelineText}" />
                        <TextBlock x:Name="LatestWechatFailureSummaryTextBlock"
                                   Margin="0,6,0,0"
                                   Text="{Binding LatestWechatFailureSummaryText}"
                                   TextWrapping="Wrap" />
                        <Grid Margin="0,8,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource SectionSubtitleStyle}" Text="Trigger" />
                          <TextBlock x:Name="LatestWechatFailureTriggerTextBlock"
                                     Grid.Row="0"
                                     Grid.Column="2"
                                     Text="{Binding LatestWechatFailureTriggerText}"
                                     TextWrapping="Wrap" />
                          <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource SectionSubtitleStyle}" Text="Capability" />
                          <TextBlock x:Name="LatestWechatFailureCapabilityTextBlock"
                                     Grid.Row="2"
                                     Grid.Column="2"
                                     Text="{Binding LatestWechatFailureCapabilityText}"
                                     TextWrapping="Wrap" />
                          <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource SectionSubtitleStyle}" Text="Upgrade" />
                          <TextBlock x:Name="LatestWechatFailureUpgradeTextBlock"
                                     Grid.Row="4"
                                     Grid.Column="2"
                                     Text="{Binding LatestWechatFailureUpgradeText}"
                                     TextWrapping="Wrap" />
                          <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource SectionSubtitleStyle}" Text="Error" />
                          <TextBlock x:Name="LatestWechatFailureErrorTextBlock"
                                     Grid.Row="6"
                                     Grid.Column="2"
                                     Text="{Binding LatestWechatFailureErrorText}"
                                     TextWrapping="Wrap" />
                        </Grid>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>
                <TextBlock Margin="0,12,0,4" Style="{StaticResource SectionSubtitleStyle}" Text="Startup" />
                <TextBlock Text="{Binding AutoStartStateText}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>

          <Border x:Name="LogCard" Grid.Row="2" Style="{StaticResource PanelCardStyle}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="4" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource AccentBrush}" CornerRadius="2" />
                <TextBlock Grid.Column="2"
                           Style="{StaticResource SectionTitleStyle}"
                           VerticalAlignment="Center"
                           Text="实时日志" />
                <Button Grid.Column="3"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ClearLogsCommand}"
                        Content="清空日志" />
              </Grid>

              <TextBox x:Name="LogTextBox"
                       Grid.Row="2"
                       Text="{Binding LogText, Mode=OneWay}"
                       IsReadOnly="True"
                       FontFamily="Consolas"
                       Background="{StaticResource InputFillBrush}"
                       BorderBrush="{StaticResource InputBorderBrush}"
                       TextWrapping="NoWrap"
                       AcceptsReturn="True"
                       VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Auto"
                       TextChanged="LogTextBox_OnTextChanged" />
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
