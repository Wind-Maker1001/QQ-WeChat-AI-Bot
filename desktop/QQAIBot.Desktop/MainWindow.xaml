                                         Style="{StaticResource FieldLabelStyle}"
                                         Text="Bridge 地址" />
                              <TextBox x:Name="WechatBridgeUrlTextBox"
                                       Text="{Binding WechatBridgeUrl, UpdateSourceTrigger=PropertyChanged}" />
                              <TextBlock Margin="0,16,0,8"
                                         Style="{StaticResource FieldLabelStyle}"
                                         Text="Bridge Token" />
                              <TextBox Text="{Binding WechatBridgeToken, UpdateSourceTrigger=PropertyChanged}" />
                              <TextBlock Margin="0,16,0,8"
                                         Style="{StaticResource FieldLabelStyle}"
                                         Text="触发前缀" />
                              <TextBox x:Name="WechatBotPrefixTextBox"
                                       Text="{Binding WechatBotPrefix, UpdateSourceTrigger=PropertyChanged}" />
                              <TextBlock Margin="0,12,0,0"
                                         Style="{StaticResource CaptionTextStyle}"
                                         Text="{Binding WechatRuntimeReadyText}" />
