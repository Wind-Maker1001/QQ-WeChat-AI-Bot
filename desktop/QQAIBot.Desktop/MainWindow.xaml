<Window x:Class="QQAIBot.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:QQAIBot.Desktop.Models"
        Title="Local AI Runtime Console"
        Width="1480"
        Height="920"
        MinWidth="1260"
        MinHeight="780"
        WindowStartupLocation="CenterScreen">
  <Grid Background="{StaticResource HeroGradientBrush}">
    <Grid Margin="20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="14" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="14" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border x:Name="HeroHeaderCard" Grid.Row="0" Style="{StaticResource HeroCardStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0"
                  CornerRadius="3"
                  Background="{StaticResource AccentStripBrush}" />

          <StackPanel Grid.Column="2">
            <TextBlock FontFamily="Segoe UI Variable Display"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Text="Local AI Runtime 控制台" />
             <TextBlock Margin="0,6,0,0"
                        Style="{StaticResource SectionSubtitleStyle}"
                       Text="管理 QQ / WeChat 通道、控制 API、本机连接设置和状态快照，适合长期托盘常驻。" />

            <WrapPanel Margin="0,14,0,0">
              <Border Padding="12,6"
                      Margin="0,0,10,0"
                      CornerRadius="999"
                      Background="{StaticResource AccentSoftBrush}"
                      BorderBrush="#66C62828"
                      BorderThickness="1">
                <TextBlock FontWeight="SemiBold"
                           Foreground="{StaticResource AccentDarkBrush}"
                           Text="{Binding ProcessStateText}" />
              </Border>

              <Border Padding="12,6"
                      Margin="0,0,10,0"
                      CornerRadius="999"
                      BorderThickness="1">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource WarningFillBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="False">
                        <Setter Property="Background" Value="{StaticResource SuccessFillBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           Text="{Binding ConfigStateText}" />
              </Border>

              <Border Padding="12,6"
                      CornerRadius="999"
                      Background="#33E5E7EB"
                      BorderBrush="{StaticResource SubtleBorderBrush}"
                      BorderThickness="1">
                <TextBlock FontWeight="SemiBold"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="{Binding StatusText}" />
              </Border>
            </WrapPanel>

            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0"
                      Padding="12,10"
                      CornerRadius="10"
                      Background="{StaticResource PanelFillBrush}"
                      BorderBrush="{StaticResource SubtleBorderBrush}"
                      BorderThickness="1">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource SectionSubtitleStyle}" Text="首次打开" />
                    <Border Grid.Column="1"
                            Padding="8,3"
                            CornerRadius="999"
                            Background="{StaticResource SuccessFillBrush}"
                            BorderBrush="{StaticResource SuccessBorderBrush}"
                            BorderThickness="1">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFirstRunGuideComplete}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Style="{StaticResource SectionSubtitleStyle}" Text="首次安装已完成" />
                    </Border>
                  </Grid>
                  <TextBlock x:Name="FirstRunGuideTextBlock"
                             Margin="0,6,0,0"
                             Foreground="{StaticResource PrimaryTextBrush}"
                             Text="{Binding FirstRunGuideText}"
                             TextWrapping="Wrap" />
                  <WrapPanel Margin="0,8,0,0">
                    <Border Padding="8,3"
                            Margin="0,0,8,0"
                            CornerRadius="999"
                            Background="{StaticResource PanelFillBrush}"
                            BorderBrush="{StaticResource InputBorderBrush}"
                            BorderThickness="1">
                      <TextBlock x:Name="FirstRunGuideProgressTextBlock"
                                 Style="{StaticResource SectionSubtitleStyle}"
                                 Text="{Binding FirstRunGuideProgressText}" />
                    </Border>
                    <Border Padding="8,3"
                            CornerRadius="999"
                            Background="{StaticResource AccentSoftBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1">
                      <TextBlock x:Name="FirstRunGuideCurrentTextBlock"
                                 Style="{StaticResource SectionSubtitleStyle}"
                                 Foreground="{StaticResource AccentDarkBrush}"
                                 Text="{Binding FirstRunGuideCurrentStepText}" />
                    </Border>
                  </WrapPanel>
                  <TextBlock x:Name="FirstRunGuideCompletionTextBlock"
                             Margin="0,8,0,0"
                             Foreground="{StaticResource AccentDarkBrush}"
                             FontWeight="SemiBold"
                             Text="{Binding FirstRunGuideCompletionText}"
                             TextWrapping="Wrap">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding FirstRunGuideCompletionText}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding FirstRunGuideCompletionText}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <ItemsControl x:Name="FirstRunGuideStepsItemsControl"
                                Margin="0,8,0,0"
                                ItemsSource="{Binding FirstRunGuideSteps}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type models:DesktopGuideStepItem}">
                        <Border Margin="0,0,0,8"
                                Padding="10,8"
                                CornerRadius="8"
                                BorderThickness="1">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Background" Value="{StaticResource InputFillBrush}" />
                              <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                  <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                  <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                  <Setter Property="BorderThickness" Value="2" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                  <Setter Property="Background" Value="{StaticResource SuccessFillBrush}" />
                                  <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <StackPanel>
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <Border Width="26"
                                      Height="26"
                                      CornerRadius="13"
                                      BorderThickness="1">
                                <Border.Style>
                                  <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource PanelFillBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                      </DataTrigger>
                                      <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SuccessFillBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Border.Style>
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="{Binding StepNumber}" />
                              </Border>
                              <TextBlock Grid.Column="2"
                                         FontWeight="SemiBold"
                                         Text="{Binding Title}">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                              <Border Grid.Column="4"
                                      Padding="8,3"
                                      CornerRadius="999"
                                      BorderThickness="1">
                                <Border.Style>
                                  <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource PanelFillBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                      </DataTrigger>
                                      <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SuccessFillBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Border.Style>
                                <TextBlock Style="{StaticResource SectionSubtitleStyle}"
                                           Text="{Binding StatusText}" />
                              </Border>
                            </Grid>
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="{Binding Detail}"
                                       TextWrapping="Wrap" />
                            <Button Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding DataContext.RunHealthActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding ActionKey}"
                                    Content="{Binding ActionLabel}">
                              <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                  <Setter Property="Visibility" Value="Visible" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                      <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ActionLabel}" Value="">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Button.Style>
                            </Button>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Grid.Column="2"
                      Padding="12,10"
                      CornerRadius="10"
                      Background="{StaticResource PanelFillBrush}"
                      BorderBrush="{StaticResource SubtleBorderBrush}"
                      BorderThickness="1">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource SectionSubtitleStyle}" Text="日常常驻" />
                    <Border Grid.Column="1"
                            Padding="8,3"
                            CornerRadius="999"
                            Background="{StaticResource SuccessFillBrush}"
                            BorderBrush="{StaticResource SuccessBorderBrush}"
                            BorderThickness="1">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDailyUseGuideComplete}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Style="{StaticResource SectionSubtitleStyle}" Text="已进入日常模式" />
                    </Border>
                  </Grid>
                  <TextBlock x:Name="DailyUseGuideTextBlock"
                             Margin="0,6,0,0"
                             Foreground="{StaticResource PrimaryTextBrush}"
                             Text="{Binding DailyUseGuideText}"
                             TextWrapping="Wrap" />
                  <WrapPanel Margin="0,8,0,0">
                    <Border Padding="8,3"
                            Margin="0,0,8,0"
                            CornerRadius="999"
                            Background="{StaticResource PanelFillBrush}"
                            BorderBrush="{StaticResource InputBorderBrush}"
                            BorderThickness="1">
                      <TextBlock x:Name="DailyUseGuideProgressTextBlock"
                                 Style="{StaticResource SectionSubtitleStyle}"
                                 Text="{Binding DailyUseGuideProgressText}" />
                    </Border>
                    <Border Padding="8,3"
                            CornerRadius="999"
                            Background="{StaticResource AccentSoftBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1">
                      <TextBlock x:Name="DailyUseGuideCurrentTextBlock"
                                 Style="{StaticResource SectionSubtitleStyle}"
                                 Foreground="{StaticResource AccentDarkBrush}"
                                 Text="{Binding DailyUseGuideCurrentStepText}" />
                    </Border>
                  </WrapPanel>
                  <TextBlock x:Name="DailyUseGuideCompletionTextBlock"
                             Margin="0,8,0,0"
                             Foreground="{StaticResource AccentDarkBrush}"
                             FontWeight="SemiBold"
                             Text="{Binding DailyUseGuideCompletionText}"
                             TextWrapping="Wrap">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding DailyUseGuideCompletionText}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding DailyUseGuideCompletionText}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <ItemsControl x:Name="DailyUseGuideStepsItemsControl"
                                Margin="0,8,0,0"
                                ItemsSource="{Binding DailyUseGuideSteps}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type models:DesktopGuideStepItem}">
                        <Border Margin="0,0,0,8"
                                Padding="10,8"
                                CornerRadius="8"
                                BorderThickness="1">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Background" Value="{StaticResource InputFillBrush}" />
                              <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                  <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                  <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                  <Setter Property="BorderThickness" Value="2" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                  <Setter Property="Background" Value="{StaticResource SuccessFillBrush}" />
                                  <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <StackPanel>
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <Border Width="26"
                                      Height="26"
                                      CornerRadius="13"
                                      BorderThickness="1">
                                <Border.Style>
                                  <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource PanelFillBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                      </DataTrigger>
                                      <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SuccessFillBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Border.Style>
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="{Binding StepNumber}" />
                              </Border>
                              <TextBlock Grid.Column="2"
                                         FontWeight="SemiBold"
                                         Text="{Binding Title}">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                              <Border Grid.Column="4"
                                      Padding="8,3"
                                      CornerRadius="999"
                                      BorderThickness="1">
                                <Border.Style>
                                  <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource PanelFillBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                      </DataTrigger>
                                      <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SuccessFillBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Border.Style>
                                <TextBlock Style="{StaticResource SectionSubtitleStyle}"
                                           Text="{Binding StatusText}" />
                              </Border>
                            </Grid>
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="{Binding Detail}"
                                       TextWrapping="Wrap" />
                            <Button Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding DataContext.RunHealthActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding ActionKey}"
                                    Content="{Binding ActionLabel}">
                              <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                  <Setter Property="Visibility" Value="Visible" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                      <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ActionLabel}" Value="">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Button.Style>
                            </Button>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </Grid>

            <Border x:Name="OverallReadinessBorder"
                    Margin="0,14,0,0"
                    Padding="12,10"
                    CornerRadius="10"
                    BorderThickness="1">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{StaticResource WarningFillBrush}" />
                  <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOverallReadinessSetupComplete}" Value="True">
                      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsOverallReadinessReady}" Value="True">
                      <Setter Property="Background" Value="{StaticResource SuccessFillBrush}" />
                      <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="OverallReadinessStateTextBlock"
                             FontWeight="SemiBold"
                             Text="{Binding OverallReadinessStateText}" />
                  <Button x:Name="OverallReadinessActionButton"
                          Grid.Column="1"
                          Margin="12,0,0,0"
                          HorizontalAlignment="Right"
                          Command="{Binding RunHealthActionCommand}"
                          CommandParameter="{Binding OverallReadinessActionKey}"
                          Content="{Binding OverallReadinessActionLabel}">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding OverallReadinessActionLabel}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                </Grid>
                <TextBlock x:Name="OverallReadinessSummaryTextBlock"
                           Margin="0,8,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="{Binding OverallReadinessSummaryText}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="OverallReadinessRecentActivityTextBlock"
                           Margin="0,8,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="{Binding OverallReadinessRecentActivityText}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <Border x:Name="ToolbarShellCard" Grid.Row="2" Style="{StaticResource ShellCardStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Orientation="Horizontal">
            <Button Margin="0,0,8,0"
                    x:Name="AutoDetectButton"
                    Style="{StaticResource PillButtonStyle}"
                    Command="{Binding AutoDetectCommand}"
                    Content="自动检测" />
            <Button Margin="0,0,8,0"
                    Style="{StaticResource PillButtonStyle}"
                    Command="{Binding OpenBackendFolderCommand}"
                    Content="打开目录" />
            <Button Margin="0,0,8,0"
                    Style="{StaticResource PillButtonStyle}"
                    Command="{Binding ToggleAutoStartCommand}"
                    Content="{Binding AutoStartButtonText}" />
            <Border Padding="14,10"
                    CornerRadius="9"
                    Background="#00FFFFFF"
                    BorderBrush="#00FFFFFF"
                    BorderThickness="1">
              <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                         Text="{Binding BackendRootStateText}" />
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Margin="0,0,8,0"
                    x:Name="ReloadButton"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ReloadCommand}"
                    Content="重新加载" />
            <Button Margin="0,0,8,0"
                    x:Name="SaveButton"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding SaveCommand}"
                    Content="保存配置" />
            <Button Margin="0,0,8,0"
                    x:Name="StartButton"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding StartCommand}"
                    Content="启动后端" />
            <Button x:Name="StopButton"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding StopCommand}"
                    Content="停止后端" />
            <Button Margin="8,0,0,0"
                    x:Name="ExitDesktopButton"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="ExitDesktopButton_OnClick"
                    Content="Exit Desktop" />
          </StackPanel>

          <TextBlock x:Name="ResidentModeDetailTextBlock"
                     Grid.Row="1"
                     Grid.ColumnSpan="2"
                     Margin="0,12,0,0"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     Text="{Binding ResidentModeDetailText}"
                     TextWrapping="Wrap" />
          <Border Grid.Row="2"
                  Grid.ColumnSpan="2"
                  Margin="0,12,0,0"
                  Padding="12,10"
                  CornerRadius="8"
                  Background="{StaticResource PanelFillBrush}"
                  BorderBrush="{StaticResource SubtleBorderBrush}"
                  BorderThickness="1">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionSubtitleStyle}" Text="Desktop Shell Vs Runtime" />
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="10,8"
                        CornerRadius="8"
                        Background="{StaticResource InputFillBrush}"
                        BorderBrush="{StaticResource InputBorderBrush}"
                        BorderThickness="1">
                  <StackPanel>
                    <TextBlock Style="{StaticResource SectionSubtitleStyle}" Text="Close To Tray" />
                    <TextBlock x:Name="CloseToTrayBehaviorTextBlock"
                               Margin="0,6,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{Binding CloseToTrayBehaviorText}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Padding="10,8"
