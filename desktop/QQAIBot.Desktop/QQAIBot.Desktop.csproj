<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>QQAIBot.Desktop</AssemblyName>
    <RootNamespace>QQAIBot.Desktop</RootNamespace>
    <ApplicationIcon>..\..\installer\assets\qq-ai-bot.ico</ApplicationIcon>
    <AssemblyTitle>Local AI Runtime Console</AssemblyTitle>
    <Product>Local AI Runtime</Product>
    <Description>Desktop control console for the local multi-process AI runtime.</Description>
    <Company>Wind-Maker1001</Company>
    <Authors>Wind-Maker1001</Authors>
    <Copyright>Copyright (c) Wind-Maker1001</Copyright>
    <RepositoryUrl>https://github.com/Wind-Maker1001/QQ-WeChat-AI-Bot</RepositoryUrl>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">1.0.0.0</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">1.0.0.0</FileVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)</InformationalVersion>
  </PropertyGroup>
</Project>
