<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="WindowBackgroundColor">#FFF6F7F9</Color>
  <Color x:Key="WindowBackgroundAccentColor">#FFF0F4FB</Color>
  <Color x:Key="CardFillColor">#FCFFFFFF</Color>
  <Color x:Key="PanelFillColor">#FFFBFCFD</Color>
  <Color x:Key="InsetFillColor">#FFF9FAFB</Color>
  <Color x:Key="PrimaryTextColor">#FF111827</Color>
  <Color x:Key="SecondaryTextColor">#FF4B5563</Color>
  <Color x:Key="MutedTextColor">#FF6B7280</Color>
  <Color x:Key="AccentColor">#FF0F6CBD</Color>
  <Color x:Key="AccentHoverColor">#FF115EA3</Color>
  <Color x:Key="AccentPressedColor">#FF0C4A7C</Color>
  <Color x:Key="AccentSoftColor">#FFEAF3FB</Color>
  <Color x:Key="SuccessColor">#FF107C10</Color>
  <Color x:Key="SuccessFillColor">#FFF3FBF3</Color>
  <Color x:Key="SuccessBorderColor">#FFD5EED5</Color>
  <Color x:Key="WarningColor">#FF8A5A00</Color>
  <Color x:Key="WarningFillColor">#FFFFF8E8</Color>
  <Color x:Key="WarningBorderColor">#FFF6DE9D</Color>
  <Color x:Key="DangerColor">#FFB42318</Color>
  <Color x:Key="DangerFillColor">#FFFFF4F4</Color>
  <Color x:Key="DangerBorderColor">#FFF6C8C5</Color>
  <Color x:Key="InfoColor">#FF0A5BC2</Color>
  <Color x:Key="InfoFillColor">#FFF2F7FF</Color>
  <Color x:Key="InfoBorderColor">#FFD1E3FF</Color>
  <Color x:Key="SubtleBorderColor">#0A0F172A</Color>
  <Color x:Key="InputBorderColor">#1A0F172A</Color>
  <Color x:Key="InputFillColor">#FFFDFDFE</Color>
  <Color x:Key="DividerColor">#080F172A</Color>

  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
  <SolidColorBrush x:Key="WindowBackgroundAccentBrush" Color="{StaticResource WindowBackgroundAccentColor}" />
  <SolidColorBrush x:Key="CardFillBrush" Color="{StaticResource CardFillColor}" />
  <SolidColorBrush x:Key="PanelFillBrush" Color="{StaticResource PanelFillColor}" />
  <SolidColorBrush x:Key="InsetFillBrush" Color="{StaticResource InsetFillColor}" />
  <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="SuccessFillBrush" Color="{StaticResource SuccessFillColor}" />
  <SolidColorBrush x:Key="SuccessBorderBrush" Color="{StaticResource SuccessBorderColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="WarningFillBrush" Color="{StaticResource WarningFillColor}" />
  <SolidColorBrush x:Key="WarningBorderBrush" Color="{StaticResource WarningBorderColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="DangerFillBrush" Color="{StaticResource DangerFillColor}" />
  <SolidColorBrush x:Key="DangerBorderBrush" Color="{StaticResource DangerBorderColor}" />
  <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
  <SolidColorBrush x:Key="InfoFillBrush" Color="{StaticResource InfoFillColor}" />
  <SolidColorBrush x:Key="InfoBorderBrush" Color="{StaticResource InfoBorderColor}" />
  <SolidColorBrush x:Key="SubtleBorderBrush" Color="{StaticResource SubtleBorderColor}" />
  <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}" />
  <SolidColorBrush x:Key="InputFillBrush" Color="{StaticResource InputFillColor}" />
  <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />

  <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="#FFF6F8FB" />
    <GradientStop Offset="0.42" Color="#FFF1F4F8" />
    <GradientStop Offset="1" Color="#FFEFF2F7" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="MicaOverlayBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="#99FFFFFF" />
    <GradientStop Offset="1" Color="#66ECF2FB" />
  </LinearGradientBrush>

  <Style TargetType="Window">
    <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="UseLayoutRounding" Value="True" />
  </Style>

  <Style x:Key="PageTitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
  </Style>

  <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
  </Style>

  <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
  </Style>

  <Style x:Key="CardTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
  </Style>

  <Style x:Key="SectionSubtitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="SectionEyebrowStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
  </Style>

  <Style x:Key="HeaderMetaLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="HeaderMetaValueStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="SummaryPrimaryValueStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="SummaryHeroValueStyle" TargetType="TextBlock" BasedOn="{StaticResource SummaryPrimaryValueStyle}">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI" />
  </Style>

  <Style x:Key="SummaryLeadTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="SummaryRowLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
  </Style>

  <Style x:Key="SummaryRowValueStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style x:Key="HeroCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource CardFillBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="18" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#100F172A" Opacity="0.12" />
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PanelCardStyle" TargetType="Border" BasedOn="{StaticResource HeroCardStyle}">
    <Setter Property="Padding" Value="18" />
    <Setter Property="Background" Value="{StaticResource CardFillBrush}" />
  </Style>

  <Style x:Key="ShellCardStyle" TargetType="Border" BasedOn="{StaticResource HeroCardStyle}">
    <Setter Property="Padding" Value="14" />
    <Setter Property="Background" Value="#F8FFFFFF" />
  </Style>

  <Style x:Key="SummaryCardStyle" TargetType="Border" BasedOn="{StaticResource PanelCardStyle}">
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style x:Key="EmphasisSummaryCardStyle" TargetType="Border" BasedOn="{StaticResource SummaryCardStyle}">
    <Setter Property="BorderBrush" Value="#220F6CBD" />
  </Style>

  <Style x:Key="InsetPanelStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource InsetFillBrush}" />
    <Setter Property="BorderBrush" Value="#080F172A" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14" />
  </Style>

  <Style x:Key="SubtleInfoBarStyle" TargetType="Border">
    <Setter Property="Background" Value="#60F9FBFD" />
    <Setter Property="BorderBrush" Value="#0C0F6CBD" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,9" />
  </Style>

  <Style x:Key="SummaryListCardStyle" TargetType="Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="#060F172A" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,12" />
  </Style>

  <Style x:Key="StatusBadgeTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
  </Style>

  <Style x:Key="PrimaryButtonStyle" TargetType="Button">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="MinWidth" Value="104" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
              <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Property="Background" Value="{StaticResource AccentPressedBrush}" />
              <Setter Property="BorderBrush" Value="{StaticResource AccentPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="Background" Value="{StaticResource InputFillBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
  </Style>

  <Style x:Key="CommandSecondaryButtonStyle" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    <Setter Property="Background" Value="#F0FFFFFF" />
    <Setter Property="BorderBrush" Value="#100F172A" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="MinWidth" Value="90" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="#FFFFFFFF" />
              <Setter Property="BorderBrush" Value="#220F6CBD" />
              <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
              <Setter Property="BorderBrush" Value="#280F6CBD" />
              <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TextActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderBrush" Value="#080F6CBD" />
  </Style>

  <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    <Setter Property="Background" Value="{StaticResource DangerFillBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
  </Style>

  <Style x:Key="QuietButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderBrush" Value="#00FFFFFF" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinWidth" Value="0" />
  </Style>

  <Style x:Key="PillButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
    <Setter Property="MinWidth" Value="96" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="MinHeight" Value="40" />
  </Style>

  <Style x:Key="FilterToggleButtonStyle" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    <Setter Property="Background" Value="{StaticResource InputFillBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="999">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
              <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource InputFillBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8">
            <ScrollViewer x:Name="PART_ContentHost" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
              <Setter Property="Background" Value="{StaticResource InsetFillBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="4,4" />
  </Style>

  <Style TargetType="ListBox">
    <Setter Property="Background" Value="{StaticResource InputFillBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="6" />
  </Style>

  <Style TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style TargetType="TabControl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <Grid KeyboardNavigation.TabNavigation="Local">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="12" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TabPanel x:Name="HeaderPanel"
                      Grid.Row="0"
                      Background="Transparent"
                      IsItemsHost="True" />
            <Border Grid.Row="2"
                    Background="Transparent"
                    BorderThickness="0">
              <ContentPresenter x:Name="PART_SelectedContentHost"
                                Margin="0"
                                ContentSource="SelectedContent" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="RootBorder"
                  Background="{StaticResource PanelFillBrush}"
                  BorderBrush="{StaticResource SubtleBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              ContentSource="Header"
                              Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="RootBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource CardFillBrush}" />
              <Setter TargetName="RootBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Separator">
    <Setter Property="Background" Value="{StaticResource DividerBrush}" />
    <Setter Property="Margin" Value="0,4" />
  </Style>

  <Style TargetType="Expander">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="Background" Value="#60FFFFFF" />
    <Setter Property="BorderBrush" Value="#080F172A" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10">
            <DockPanel>
              <ToggleButton x:Name="HeaderSite"
                            DockPanel.Dock="Top"
                            Background="Transparent"
                            BorderBrush="#00FFFFFF"
                            BorderThickness="0"
                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                            FocusVisualStyle="{x:Null}">
                <Grid Margin="16,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ContentPresenter ContentSource="Header" />
                  <TextBlock Grid.Column="1"
                             FontFamily="Segoe MDL2 Assets"
                             FontSize="12"
                             Foreground="{StaticResource SecondaryTextBrush}"
                             Text="&#xE70D;" />
                </Grid>
              </ToggleButton>
              <ContentPresenter x:Name="ExpandSite"
                                Margin="16,0,16,16"
                                Visibility="Collapsed" />
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
              <Setter TargetName="HeaderSite" Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            </Trigger>
            <Trigger SourceName="HeaderSite" Property="IsMouseOver" Value="True">
              <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
