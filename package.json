{
  "name": "qq-group-ai-bot",
  "version": "1.0.0",
  "private": true,
  "description": "QQ group AI bot with supervisor/worker runtime, control API, and desktop console",
  "type": "module",
  "scripts": {
    "start": "node ./src/index.mjs",
    "test": "npm run test:node && npm run test:desktop",
    "test:node": "node --test",
    "test:desktop": "dotnet build ./desktop/QQAIBot.Desktop.Tests/QQAIBot.Desktop.Tests.csproj -nologo && dotnet run --no-build --project ./desktop/QQAIBot.Desktop.Tests/QQAIBot.Desktop.Tests.csproj",
    "setup:install": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\install.ps1",
    "setup:validate": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\install.ps1 -ValidateOnly",
    "setup:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\uninstall.ps1",
    "setup:uninstall:keep-state": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\uninstall.ps1 -KeepState",
    "desktop:acceptance": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\desktop-acceptance.ps1",
    "desktop:acceptance:auto": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\desktop-acceptance.ps1 -AutomatedOnly",
    "wechat:bridge:sim": "node ./scripts/wechat-bridge-simulator.mjs",
    "release:source": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\release.ps1",
    "release:installable": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\release.ps1 -Installable",
    "release:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\build-installer.ps1",
    "release:installer:validate": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\build-installer.ps1 -ValidateOnly"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "openai": "^6.32.0",
    "ws": "^8.19.0"
  }
}
